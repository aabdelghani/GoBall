[Unit]
Description=GoBall Fleet Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/goball-agent/goball_agent.py
Environment=MQTT_BROKER_HOST=fleet.example.com
Environment=MQTT_BROKER_PORT=1883
Environment=MQTT_USERNAME=
Environment=MQTT_PASSWORD=
Environment=PUBLISH_INTERVAL=30
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
